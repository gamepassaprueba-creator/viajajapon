# ViajaJapón — variables de entorno (plantilla). Copia este archivo a `.env.local` y rellena.
# `.env.local` está ignorado por git (nunca subas claves ni enlaces de tracking al repo).
#
# ANALÍTICA — Measurement ID público de Google Analytics 4.
# No es una credencial secreta. El código usa este ID como configuración explícita.
NEXT_PUBLIC_GA4_ID=G-NGK9K8DWYP

# AFILIADOS — pega aquí el enlace de tracking COMPLETO que te da cada panel de afiliado.
# Mientras estén vacías, los enlaces apuntan a la URL canónica (funcionan pero NO pagan).
# Se leen en el BUILD (páginas estáticas): en producción van como GitHub Actions secrets,
# NO como secrets del Worker. Ver DEPLOY.md §2.

AFF_CIVITATIS=
AFF_KLOOK=
AFF_IATI=
AFF_HEYMONDO=
AFF_HOLAFLY=
AFF_AIRALO=
AFF_SKYSCANNER=
# JR Pass: enlace de un REVENDEDOR con programa. Vacío → enlace a la web oficial japanrailpass.net.
AFF_JRPASS=
AFF_REVOLUT=
# Preparados, sin activar todavía (dar de alta en el programa de afiliados antes de rellenar).
AFF_BOOKING=
AFF_GETYOURGUIDE=

# EMAIL — MailerLite (runtime: en producción, secrets del Worker de Cloudflare).
# Sin las dos, las secciones de newsletter no se muestran.
# API key desde MailerLite → Integrations → API. El Group ID desde la URL del grupo.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# SEO REPORT — bridge privado GSC + GA4 (runtime: secrets del Worker, o GitHub secrets que el
# deploy sincroniza). Se llama con la cabecera "Authorization: Bearer <SEO_REPORT_SECRET>".
# GOOGLE_SERVICE_ACCOUNT_JSON: JSON completo de una service account con acceso de lectura
# a Search Console y a la propiedad GA4. No subir nunca el valor real al repositorio.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Search Console acepta una propiedad de dominio como sc-domain:viajajapon.com.
GSC_SITE_URL=sc-domain:viajajapon.com
# ID numérico de la propiedad GA4 (no el Measurement ID G-XXXX). El de ViajaJapón es 550129763.
GA4_PROPERTY_ID=
# Secreto largo para proteger GET /api/seo/report desde cron-job.org.
SEO_REPORT_SECRET=

# OPCIONALES (build) — desactivados a propósito. Antes de activarlos, actualiza /privacidad y /cookies.
# Beacon de Cloudflare Web Analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# AdSense: en la UE exige además una CMP certificada (TCF).
NEXT_PUBLIC_ADSENSE_CLIENT=
