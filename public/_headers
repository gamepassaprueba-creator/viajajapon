# Cabeceras de los ASSETS ESTÁTICOS (Cloudflare Workers Static Assets):
# https://developers.cloudflare.com/workers/static-assets/headers
# Solo afectan a ficheros servidos desde los assets (chunks, fuentes, imágenes de public/).
# El HTML lo genera el Worker y conserva su propio Cache-Control (s-maxage) de OpenNext.
# Sin este fichero todo salía con "max-age=0, must-revalidate".

# Chunks, CSS y fuentes de Next llevan hash en el nombre: inmutables.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes de public/: cacheables, pero NO inmutables (se han sobrescrito in-place en el historial).
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/avatares/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
