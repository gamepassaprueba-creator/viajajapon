{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "viajajapon",
	"compatibility_date": "2025-03-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Solo se sirve por los dominios propios (viajajapon.com y redirecciones).
	// Sin esto Wrangler deja activa la URL *.workers.dev: un host duplicado del
	// sitio que se salta las redirecciones y cualquier regla de la zona.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	"images": {
		// Optimización de imágenes en Cloudflare (sirve el hero en AVIF/WebP).
		"binding": "IMAGES"
	}
}
